@Estoques.API_HostAddress = http://localhost:5237

### Login do Usuário (Gerar o Token JWT)
# @name login
POST {{Estoques.API_HostAddress}}/api/autenticacao/login
Content-Type: application/json

{
  "NMLogin": "teste",
  "CDSenha": "123123"
}

### USUARIO =======================================================

### Cadastro do Usuário
POST {{Estoques.API_HostAddress}}/api/usuarios
Content-Type: application/json

{
  "NMUsuario": "Testador",
  "NMLogin": "teste",
  "CDSenha": "123123"
}

### Atualização do Usuário
PUT {{Estoques.API_HostAddress}}/api/usuarios
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.cdToken}}

{
  "IDUsuario": 1,
  "NMUsuario": "Testador Atualizado",
  "NMLogin": "teste",
  "CDSenha": "123123"
}

### Perfil do Usuário
GET {{Estoques.API_HostAddress}}/api/usuarios/perfil
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.cdToken}}



### Adquirente ====================================================

### Retorna Adquirente
GET {{Estoques.API_HostAddress}}/api/adquirentes
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.cdToken}}

### Cadastro do Adquirente
POST {{Estoques.API_HostAddress}}/api/adquirentes
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.cdToken}}

{
  "NMAdquirente": "Adquirente Teste",
  "TXEndereco": "Rua Teste",
  "TXAnotacao": "Anotação Teste"
}

### Atualização do Adquirente
PUT {{Estoques.API_HostAddress}}/api/adquirentes
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.cdToken}}

{
  "IDAdquirente" : 1,
  "NMAdquirente": "Adquirente Teste Atualizado",
  "TXEndereco": "Rua Teste Atualizado",
  "TXAnotacao": "Anotação Teste Atualizado"
}

### Exclusão do Adquirente
DELETE {{Estoques.API_HostAddress}}/api/adquirentes/12
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.cdToken}}



